{
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{index.html,node_modules/kuromoji/dict/**}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ]
}
